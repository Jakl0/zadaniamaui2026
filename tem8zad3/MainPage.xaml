<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tem8zad3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry x:Name="FirstEntry" Placeholder="Wpisz piewszy bok" Keyboard="Numeric"/>
            <Entry x:Name="SecondEntry" Placeholder="Wpisz drugi bok" Keyboard="Numeric"/>

            <Button Clicked="CalculateClick" Text="Oblicz"/>
            <Button Clicked="ClearCLick" Text="Wyczyść"/>

            <Label x:Name="ResultLabel"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
