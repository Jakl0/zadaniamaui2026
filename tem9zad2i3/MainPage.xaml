<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tem9zad2i3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry 
                x:Name="AddEntry" 
                Placeholder="produkt do listy zakupów"/>

            <Button x:Name="AddButton"
                    Text="Dodaj"
                    Clicked="AddClick"/>

            <Button x:Name="DeleteButton"
                    Text="Usuń zaznaczone"
                    Clicked="DeleteClick"/>

            <Label x:Name="CountLabel"
                   Text="Liczba elementów: 0"/>
            <CollectionView x:Name="ListaView" SelectionMode="Single">
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Label 
                                FontSize="20"
                                Text="{Binding .}"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
