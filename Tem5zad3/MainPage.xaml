<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tem5zad3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Picker x:Name="SalaPicker" SelectedIndexChanged="PickerChange"/>

            <Stepper Maximum="50" Minimum="1" ValueChanged="StepperChange"/>

            <DatePicker DateSelected="DateChange"/>

            <Button BackgroundColor="LightBlue" Text="Zarezerwuj"/>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
