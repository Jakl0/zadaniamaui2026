<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tem5zad3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Picker x:Name="SalaPicker" SelectedIndexChanged="PickerChange"/>

            
            <HorizontalStackLayout Spacing="30" Padding="10">

                <Label Text="Liczba osob"/>
                <Stepper Maximum="50" Minimum="1" ValueChanged="StepperChange" x:Name="LiczbaOsob"/>
                <Label x:Name="StepperLabel" Text=": 1"/>
            </HorizontalStackLayout>
            
            
            <DatePicker DateSelected="DateChange" x:Name="DataPick" Format="dd.MM.yyyy"/>

            <Button BackgroundColor="LightBlue" Text="Zarezerwuj" Clicked="ReserveClicked"/>

            <Label x:Name="DisplayLabel"/>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
