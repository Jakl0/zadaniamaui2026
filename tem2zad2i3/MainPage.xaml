<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tem2zad2i3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label x:Name="TitleLabel"
                   Text="Kalkulator powitań"/>

            <Entry Placeholder="Wpisz miasto"
                   x:Name="CityEntry"/>

            <Entry Placeholder="Wpisz imie"
                   x:Name="NameEntry"/>

            <Button Text="Pokaż"
                    x:Name="ShowButton"
                    Clicked="ShowClicked" />
            
            <Label x:Name="ResultLabel"/>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
