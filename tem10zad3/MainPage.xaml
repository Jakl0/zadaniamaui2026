<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tem10zad3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Slider Maximum="255" 
                    Minimum="0"
                    x:Name="Suwaczek"/>
            <Label Text="{Binding Source={x:Reference Suwaczek}, Path=Value,StringFormat='Wartosc {0:F0}'}" x:Name="ValueLabel"/>

            <Button x:Name="ChangeGreyButton" Text="Zastosuj jako szarość" Clicked="ChangeGreyClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
